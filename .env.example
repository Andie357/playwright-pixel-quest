# Copy to .env.local for local development, and add the same variables in Vercel.

# --- Public (shipped to the browser; safe to expose) ---------------------
# Supabase project URL: Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon / publishable key: Project Settings -> API Keys
# (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is also accepted)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: canonical public URL used for the player link and QR code.
# Defaults to the current browser origin.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# --- Server only (NEVER prefix with NEXT_PUBLIC_) -------------------------
# Service role / secret key: Project Settings -> API Keys
# (SUPABASE_SECRET_KEY is also accepted)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
